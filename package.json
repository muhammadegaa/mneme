{
  "name": "engram",
  "version": "0.1.0",
  "private": true,
  "description": "Engram — a persistent MemoryAgent with a benchmarkable memory engine. Built on Qwen + Alibaba Cloud.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace packages/memory-engine",
    "bench": "tsx bench/run.ts",
    "bench:scale": "tsx bench/scale.ts",
    "demo:catch": "tsx bench/demo-catch.ts",
    "demo:mcp": "node apps/mcp/demo.mjs",
    "demo:persist": "tsx bench/demo-persist.ts write && tsx bench/demo-persist.ts read",
    "hello": "tsx scripts/hello-qwen.ts",
    "engram": "tsx cli/engram.ts",
    "mcp": "tsx apps/mcp/server.ts",
    "dev": "npm run dev --workspace apps/api",
    "start": "npm run start --workspace apps/api",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "proof": "tsx alibaba/proof.ts"
  },
  "dependencies": {
    "ali-oss": "^6.21.0"
  },
  "devDependencies": {
    "playwright-core": "^1.61.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
